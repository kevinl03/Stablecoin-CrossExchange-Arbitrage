# ──────────────────────────────────────────────────────────
#  Wallet private key for automated signing
#
#  1. Copy this file:  cp .env.example .env
#  2. Paste your private key below (with 0x prefix)
#  3. NEVER commit .env to git
#
#  To export from MetaMask:
#    Account Details → Show Private Key → copy
#    Prefix with 0x if it doesn't have one
# ──────────────────────────────────────────────────────────

PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
